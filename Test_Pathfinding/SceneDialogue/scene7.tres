scene_dialogue = Array[String](["BELLADONNA DIGGER!", "Your greed has sealed your fate.", "Now you shall pay the price! ", "AHHHH! What is this!?", "You have three days.", "THREE DAYS FOR WHAT?!", "You have three days to pay the toll of a soul.", "Survive this island and repay your debt.", "Fail, and your soul will wander these shores forever,", "searching for treasure, but never finding it."])
